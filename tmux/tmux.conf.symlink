# Cleanup some env vars.
set-option -g update-environment 'SSH_CLIENT SSH_CONNECTION'

# Export the proper TERM and use xterm keys.
set -g default-terminal "tmux-256color"
setw -g xterm-keys on
set -as terminal-overrides ",*:Tc,*:RGB"

# Enable focus events for modern editors/tools
set -g focus-events on

# Renumber windows sequentially after closing any of them
set -g renumber-windows on

# Do not launch a login shell.
set -g default-command "${SHELL}"

# Emacs key bindings in status line and copy mode
setw -g mode-keys emacs
set -g status-keys emacs
set -g extended-keys on
set -g extended-keys-format csi-u

# Enable mouse support
set -g mouse on
setw -g mouse on

# Multi-platform Emacs copy-mode clipboard integration
if-shell -b 'command -v wl-copy >/dev/null 2>&1' {
  bind-key -T copy-mode M-w send-keys -X copy-pipe-and-cancel "wl-copy"
  bind-key -T copy-mode-emacs M-w send-keys -X copy-pipe-and-cancel "wl-copy"
  bind-key -T copy-mode C-w send-keys -X copy-pipe-and-cancel "wl-copy"
  bind-key -T copy-mode-emacs C-w send-keys -X copy-pipe-and-cancel "wl-copy"
  bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "wl-copy"
  bind-key -T copy-mode-emacs MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "wl-copy"
} {
  if-shell -b 'command -v xclip >/dev/null 2>&1' {
    bind-key -T copy-mode M-w send-keys -X copy-pipe-and-cancel "xclip -selection clipboard -in"
    bind-key -T copy-mode-emacs M-w send-keys -X copy-pipe-and-cancel "xclip -selection clipboard -in"
    bind-key -T copy-mode C-w send-keys -X copy-pipe-and-cancel "xclip -selection clipboard -in"
    bind-key -T copy-mode-emacs C-w send-keys -X copy-pipe-and-cancel "xclip -selection clipboard -in"
    bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "xclip -selection clipboard -in"
    bind-key -T copy-mode-emacs MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "xclip -selection clipboard -in"
  } {
    if-shell -b 'command -v pbcopy >/dev/null 2>&1' {
      bind-key -T copy-mode M-w send-keys -X copy-pipe-and-cancel "pbcopy"
      bind-key -T copy-mode-emacs M-w send-keys -X copy-pipe-and-cancel "pbcopy"
      bind-key -T copy-mode C-w send-keys -X copy-pipe-and-cancel "pbcopy"
      bind-key -T copy-mode-emacs C-w send-keys -X copy-pipe-and-cancel "pbcopy"
      bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "pbcopy"
      bind-key -T copy-mode-emacs MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "pbcopy"
    }
  }
}

# Binding with C-b b and nested instances.
bind-key b send-prefix

# C-b C-b will go to the last active window.
bind C-b last-window

# 1-based indexing for windows and panes.
set -g base-index 1
setw -g pane-base-index 1

# Faster escape sequences
set -s escape-time 0

# Efficient resizing with hidden windows.
setw -g aggressive-resize off

# Scrollback buffer (50k lines)
set -g history-limit 50000

# Display messages time
set -g display-time 5000

# Prominent pane styling.
set -g window-active-style 'fg=terminal,bg=terminal'
set -g window-style 'fg=colour247,bg=colour236'

set -g pane-border-style 'fg=colour238,bg=colour236'
set -g pane-active-border-style 'fg=brightred,bg=default'

set -g message-style 'bg=black,fg=brightred'

# Clean status bar and window formats
set -g status on
set -g status-interval 5
set -g status-position bottom
set -g status-style 'bg=black,fg=white'

set -g status-left '#[fg=blue,bold] #S #[default] '
set -g status-left-length 30
set -g status-right '#[fg=green] %H:%M #[default]'
set -g status-right-length 50

setw -g window-status-format ' #I:#W '
setw -g window-status-current-format '#[bg=red,fg=white,bold] #I:#W #[default]'

# Quiet activity alerts
set -g bell-action none
setw -g monitor-activity on
set -g visual-activity off

# Window management
bind v split-window -h -c "#{pane_current_path}"
bind s split-window -v -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"

# Emacs quick spawn
bind e split-window -p 60 -c "#{pane_current_path}" 'emacs -a "" -nw'
bind E split-window -h -c "#{pane_current_path}" 'emacs -a "" -nw'

# Terminal title
set -g set-titles on
set -g set-titles-string '#W@#h'

# Open IRC
bind i new-window irssi
