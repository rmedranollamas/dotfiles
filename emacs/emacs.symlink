;;; init.el --- Emacs initialization. -*- lexical-binding: t; -*-

;; Set UTF-8 as default encoding.
(setq locale-coding-system 'utf-8)
(set-terminal-coding-system 'utf-8)
(set-keyboard-coding-system 'utf-8)
(set-selection-coding-system 'utf-8)
(prefer-coding-system 'utf-8)

;; Keep custom settings out of init file.
(setq custom-file (expand-file-name "custom.el" user-emacs-directory))
(when (file-exists-p custom-file)
  (load custom-file t))

;; Load package config.
(load (expand-file-name "config/0package-config" user-emacs-directory))

;; Load all modular configuration files in ~/.emacs.d/load.d/ dynamically.
(let ((load-directory (expand-file-name "load.d" user-emacs-directory)))
  (when (file-directory-p load-directory)
    (dolist (file (directory-files load-directory t "\\.el$"))
      (unless (or (string-prefix-p "." (file-name-nondirectory file))
                  (string-suffix-p "~" file))
        (load (file-name-sans-extension file) nil t)))))
